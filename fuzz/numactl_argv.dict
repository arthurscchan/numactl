# libFuzzer dictionary for the numactl command line
# long options (getopt_long names from numactl.c)
"--all"
"--interleave"
"--weighted-interleave"
"--preferred"
"--preferred-many"
"--cpubind"
"--cpunodebind"
"--physcpubind"
"--membind"
"--show"
"--localalloc"
"--balancing"
"--hardware"
"--shm"
"--file"
"--offset"
"--length"
"--strict"
"--shmmode"
"--dump"
"--dump-nodes"
"--dump-shm"
"--shmid"
"--huge"
"--touch"
"--cpu-compress"
"--verify"
"--version"
# short options
"-a"
"-i"
"-w"
"-p"
"-P"
"-c"
"-N"
"-C"
"-m"
"-s"
"-l"
"-b"
"-H"
"-S"
"-f"
"-o"
"-L"
"-t"
"-M"
"-d"
"-D"
"-I"
"-u"
"-T"
"-V"
# node/cpu string grammar (libnuma parsers + numactl extensions)
"all"
"same"
"0-3"
"!0"
"+0"
"^0"
"1,3,5-7"
"netdev:"
"file:"
"ip:"
"block:"
"pci:"
"0x0f"
# size suffixes for memsize()
"K"
"M"
"G"
"4K"
"8M"
"1G"
"9223372036854775807G"
# policy names (util.c parse_policy)
"default"
"preferred"
"bind"
"interleave"
"local"
"preferred-many"
"weighted-interleave"
# misc tokens
"--"
"/bin/true"
"/tmp/"
"0644"
